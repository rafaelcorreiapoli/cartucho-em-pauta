{
  "name": "brwars",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "tsc --noEmit",
    "test": "bun run --cwd apps/web assets && vitest run",
    "test:integration": "bun scripts/integration.ts",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build && bun run test:integration",
    "format": "prettier --write '{apps,packages,scripts}/**/*.{ts,tsx,css,json}' '*.json'",
    "format:check": "prettier --check '{apps,packages,scripts}/**/*.{ts,tsx,css,json}' '*.json'"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "bun@1.4.4"
}
